<odoo>
    <template
        id="report_invoice_document"
        inherit_id="account.report_invoice_document"
        primary="True"
        priority="100"
    >
        <!-- rename heading contents -->
        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">Request to Release Capital</t>
        </xpath>
        <!--
            rename invoice date to request date. the whole block is replaced
            because other modules (like account_debit_note) change its content.
        -->
        <xpath
            expr="//div[@id='informations']/div[@name='invoice_date']"
            position="replace"
        >
            <div class="col" t-if="o.invoice_date" name="invoice_date">
                <strong>Request Date:</strong>
                <div t-field="o.invoice_date" />
            </div>
        </xpath>
        <!-- remove due date -->
        <xpath
            expr="//div[@id='informations']/div[@name='due_date']"
            position="replace"
        />
        <!-- remove source -->
        <xpath
            expr="//div[@id='informations']/div[@name='origin']"
            position="replace"
        />
        <!-- remove customer code -->
        <xpath
            expr="//div[@id='informations']/div[@name='customer_code']"
            position="replace"
        />
        <!--
            remove reference and add account number and contact
        -->
        <xpath
            expr="//div[@id='informations']/div[@name='reference']"
            position="replace"
        >
            <div class="col" name="account_number">
                <strong>Account Number:</strong>
                <t t-foreach="o.company_id.bank_journal_ids" t-as="journal">
                    <t t-set="b" t-value="journal.bank_account_id" />
                    <t t-if="journal.get_cooperator_payment">
                        <p class="m-0" t-field="b.acc_number" />
                    </t>
                </t>
            </div>
            <div class="col" name="contact">
                <strong>Your Contact:</strong>
                <p class="m-0" t-field="o.user_id" />
            </div>
        </xpath>
        <!-- add part type table header -->
        <xpath
            expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_description']"
            position="after"
        >
            <th name="th_part_type" class="text-start">
                <span>Part Type</span>
            </th>
        </xpath>
        <!-- remove tax table header -->
        <xpath
            expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_taxes']"
            position="replace"
        />
        <!-- add part type table cell -->
        <xpath
            expr="//table[@name='invoice_line_table']//td[@name='account_invoice_line_name']"
            position="after"
        >
            <td name="account_invoice_part_type">
                <span
                    t-field="line.product_id.short_name"
                    t-options="{'widget': 'text'}"
                />
            </td>
        </xpath>
        <!-- remove tax table cell -->
        <xpath
            expr="//table[@name='invoice_line_table']//td[@name='td_taxes']"
            position="replace"
        />
    </template>

    <template id="report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t
                    t-call="cooperator.report_invoice_document"
                    t-lang="o.partner_id.lang"
                />
            </t>
        </t>
    </template>
</odoo>
