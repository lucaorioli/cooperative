<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_cooperator_view_form" model="ir.ui.view">
        <field name="name">Cooperators</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="50" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="Cooperators"
                    string="Cooperators"
                    name="cooperator"
                    groups="cooperator.cooperator_group_user"
                >
                    <block title="General Settings" name="general_settings">
                        <setting
                            id="create_user_setting"
                            string="Create users for cooperators"
                            help="Automatically create a portal user for cooperators"
                        >
                            <field name="create_user" />
                        </setting>
                        <setting
                            id="unmix_share_type_setting"
                            string="One share type per cooperator"
                            help="Force cooperators to have only one type of share"
                        >
                            <field name="unmix_share_type" />
                        </setting>
                        <setting
                            id="subscription_maximum_amount_setting"
                            string="Maximum amount"
                            help="Maximum authorised subscription amount"
                        >
                            <field name="subscription_maximum_amount" />
                        </setting>
                        <setting
                            id="lang_id_default_setting"
                            string="Default Language"
                            help="Default language in subscription forms"
                        >
                            <field name="lang_id_default" />
                        </setting>
                        <setting
                            id="country_id_default_setting"
                            string="Default Country"
                            help="Default country in subscription forms"
                        >
                            <field name="country_id_default" />
                        </setting>
                    </block>
                    <block title="Report template" name="report_template_settings">
                        <setting
                            id="display_logo1_setting"
                            string="Logo 1"
                            help="Display a logo on the PDF reports"
                        >
                            <field name="display_logo1" />
                            <div
                                class="content-group mt16"
                                invisible="not display_logo1"
                            >
                                <field
                                    name="bottom_logo1"
                                    widget="image"
                                    class="oe_avatar float-none"
                                />
                            </div>
                        </setting>
                        <setting
                            id="display_logo2_setting"
                            string="Logo 2"
                            help="Display a second logo on the PDF reports"
                        >
                            <field name="display_logo2" />
                            <div
                                class="content-group mt16"
                                invisible="not display_logo2"
                            >
                                <field
                                    name="bottom_logo2"
                                    widget="image"
                                    class="oe_avatar float-none"
                                />
                            </div>
                        </setting>
                        <setting
                            id="board_representative_setting"
                            string="Board representative name"
                        >
                            <field name="board_representative" />
                        </setting>
                        <setting
                            id="signature_scan_setting"
                            string="Board representative signature"
                        >
                            <field
                                name="signature_scan"
                                widget="image"
                                class="oe_avatar float-none"
                            />
                        </setting>
                    </block>
                    <block title="Accounting" name="accounting_settings">
                        <setting
                            id="subscription_journal_setting"
                            string="Subscription Journal"
                        >
                            <field name="subscription_journal_id" />
                        </setting>
                        <setting
                            id="cooperator_account_setting"
                            string="Cooperator Account"
                            help="Default account to use as the receivable account for the share payments"
                        >
                            <field name="property_cooperator_account" />
                        </setting>
                        <setting
                            id="capital_release_payment_term_setting"
                            string="Default Payment Term"
                            help="Default payment term to use for capital release requests"
                        >
                            <field
                                name="capital_release_request_payment_term_default"
                            />
                        </setting>
                    </block>
                    <block title="Website form" name="website_form_settings">
                        <setting
                            id="internal_rules_approval_setting"
                            string="Internal Rules"
                            help="Display the internal rules on the cooperator website form"
                        >
                            <field name="display_internal_rules_approval" />
                            <div
                                class="content-group mt16"
                                invisible="not display_internal_rules_approval"
                            >
                                <div>
                                    <label
                                        for="internal_rules_approval_text"
                                        string="Internal Rules Text"
                                    />
                                    <field
                                        name="internal_rules_approval_text"
                                        class="oe_account_terms w-100"
                                        placeholder="These are our internal rules…"
                                    />
                                </div>
                                <div>
                                    <field name="internal_rules_approval_required" />
                                    <label
                                        for="internal_rules_approval_required"
                                        string="Require Approval"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="data_policy_approval_setting"
                            string="Data Policy"
                            help="Display the data policy on the cooperator website form"
                        >
                            <field name="display_data_policy_approval" />
                            <div
                                class="content-group mt16"
                                invisible="not display_data_policy_approval"
                            >
                                <div>
                                    <label
                                        for="data_policy_approval_text"
                                        string="Data Policy Text"
                                    />
                                    <field
                                        name="data_policy_approval_text"
                                        class="oe_account_terms w-100"
                                        placeholder="This is our data policy…"
                                    />
                                </div>
                                <div>
                                    <field name="data_policy_approval_required" />
                                    <label
                                        for="data_policy_approval_required"
                                        string="Require Approval"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="financial_risk_approval_setting"
                            string="Financial Risk"
                            help="Display information about the financial risk on the cooperator website form"
                        >
                            <field name="display_financial_risk_approval" />
                            <div
                                class="content-group mt16"
                                invisible="not display_financial_risk_approval"
                            >
                                <div>
                                    <label
                                        for="financial_risk_approval_text"
                                        string="Financial Risk Information Text"
                                    />
                                    <field
                                        name="financial_risk_approval_text"
                                        class="oe_account_terms w-100"
                                        placeholder="This is the financial risk…"
                                    />
                                </div>
                                <div>
                                    <field name="financial_risk_approval_required" />
                                    <label
                                        for="financial_risk_approval_required"
                                        string="Require Approval"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="generic_rules_approval_setting"
                            string="Generic Rules"
                            help="Display the generic rules on the cooperator website form"
                        >
                            <field name="display_generic_rules_approval" />
                            <div
                                class="content-group mt16"
                                invisible="not display_generic_rules_approval"
                            >
                                <div>
                                    <label
                                        for="generic_rules_approval_text"
                                        string="Generic Rules Text"
                                    />
                                    <field
                                        name="generic_rules_approval_text"
                                        class="oe_account_terms w-100"
                                        placeholder="These are our generic rules…"
                                    />
                                </div>
                                <div>
                                    <field name="generic_rules_approval_required" />
                                    <label
                                        for="generic_rules_approval_required"
                                        string="Require Approval"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="allow_id_card_upload_setting"
                            string="Allow ID Card upload"
                        >
                            <field name="allow_id_card_upload" />
                        </setting>
                    </block>
                    <block title="Email" name="email_settings">
                        <setting
                            id="coop_email_contact_setting"
                            string="Contact Email"
                            help="Contact email address for cooperators"
                        >
                            <field name="coop_email_contact" />
                        </setting>
                        <setting
                            id="send_certificate_email_setting"
                            string="Certificate Email Message"
                            help="Send an email message containing the cooperator certificate after a successful payment"
                        >
                            <field name="send_certificate_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_certificate_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_certificate_mail_template"
                                        string="Custom Email Template For New Cooperators"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_certificate_mail_template"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="cooperator_certificate_increase_mail_template"
                                        string="Custom Email Template For Share Increase"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_certificate_increase_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="send_confirmation_email_setting"
                            string="Share Subscription Confirmation Email Message"
                            help="Send a confirmation email message when a subscription is received"
                        >
                            <field name="send_confirmation_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_confirmation_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_confirmation_mail_template"
                                        string="Custom Email Template"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_confirmation_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="send_capital_release_email_setting"
                            string="Capital Release Request Email Message"
                            help="Send an email message containing the capital release request when a subscription is validated"
                        >
                            <field name="send_capital_release_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_capital_release_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_capital_release_mail_template"
                                        string="Custom Email Template"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_capital_release_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="send_waiting_list_email_setting"
                            string="Waiting List Email Message"
                            help="Send an email message when a subscription is put on the waiting list"
                        >
                            <field name="send_waiting_list_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_waiting_list_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_waiting_list_mail_template"
                                        string="Custom Email Template"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_waiting_list_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="send_share_transfer_email_setting"
                            string="Share Transfer Email Message"
                            help="Send an email message containing the cooperator certificate after a share transfer"
                        >
                            <field name="send_share_transfer_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_share_transfer_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_share_update_mail_template"
                                        string="Custom Email Template"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_share_update_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                        <setting
                            id="send_share_update_email_setting"
                            string="Shares Update Email Message"
                            help="Send an email message containing the cooperator certificate when shares of a cooperator are updated"
                        >
                            <field name="send_share_update_email" />
                            <div
                                class="content-group mt16"
                                invisible="not send_share_update_email"
                            >
                                <div>
                                    <label
                                        for="cooperator_share_update_mail_template"
                                        string="Custom Email Template"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_share_update_mail_template"
                                    />
                                </div>
                                <div>
                                    <label
                                        for="cooperator_share_update_no_shares_mail_template"
                                        string="Custom Email Template With No Remaining Shares"
                                        class="o_light_label mr8"
                                    />
                                    <field
                                        name="cooperator_share_update_no_shares_mail_template"
                                    />
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_cooperator_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'cooperator', 'bin_size': False}</field>
    </record>
</odoo>
