<odoo>
    <record id="subscription_request_view_form" model="ir.ui.view">
        <field name="name">subscription.request.view.form (l10n_it_cooperator)</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.subscription_request_view_form" />
        <field name="arch" type="xml">
            <field name="company_register_number" position="after">
                <field
                    name="l10n_it_codice_fiscale"
                    readonly="state != 'draft'"
                    invisible="not is_company"
                    required="is_company and country_id and country_code == 'IT'"
                />
            </field>
            <field name="type" position="after">
                <field name="l10n_it_member_type" readonly="state != 'draft'" />
            </field>
            <field name="birthdate" position="before">
                <field
                    name="l10n_it_codice_fiscale"
                    readonly="state != 'draft'"
                    invisible="is_company"
                    required="not is_company and country_id and country_code == 'IT'"
                />
            </field>
        </field>
    </record>

    <record id="subscription_request_view_search" model="ir.ui.view">
        <field name="name">subscription.request.view.search (l10n_it_cooperator)</field>
        <field name="model">subscription.request</field>
        <field name="inherit_id" ref="cooperator.view_subscription_request_filter" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_it_codice_fiscale" />
            </field>
        </field>
    </record>
</odoo>
