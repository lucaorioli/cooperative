<odoo>
    <record id="res_groups_privilege_governance" model="res.groups.privilege">
        <field name="name">Governance</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_governance_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_governance" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>
    <record id="group_governance_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_governance" />
        <field name="implied_ids" eval="[(4, ref('group_governance_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <record id="governance_body_company_rule" model="ir.rule">
        <field name="name">Corporate bodies: multi-company</field>
        <field name="model_id" ref="model_governance_body" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="governance_body_member_company_rule" model="ir.rule">
        <field name="name">Corporate body members: multi-company</field>
        <field name="model_id" ref="model_governance_body_member" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
