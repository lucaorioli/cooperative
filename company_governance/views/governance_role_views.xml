<odoo>
    <record id="governance_role_view_list" model="ir.ui.view">
        <field name="model">governance.role</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="description" />
                <field name="active" column_invisible="True" />
            </list>
        </field>
    </record>
    <record id="governance_role_action" model="ir.actions.act_window">
        <field name="name">Offices</field>
        <field name="res_model">governance.role</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
