<odoo>
    <record id="governance_body_type_view_list" model="ir.ui.view">
        <field name="model">governance.body.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="role_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>
    <record id="governance_body_type_view_form" model="ir.ui.view">
        <field name="model">governance.body.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                        <field name="role_ids" widget="many2many_tags" />
                        <field name="description" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="governance_body_type_action" model="ir.actions.act_window">
        <field name="name">Body Types</field>
        <field name="res_model">governance.body.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
