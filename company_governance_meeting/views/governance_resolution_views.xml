<odoo>
    <record id="governance_resolution_view_list" model="ir.ui.view">
        <field name="model">governance.resolution</field>
        <field name="arch" type="xml">
            <list>
                <field name="number" />
                <field name="meeting_date" />
                <field name="body_id" />
                <field name="name" />
                <field name="outcome" widget="badge" />
                <field name="votes_for" optional="show" />
                <field name="votes_against" optional="show" />
                <field name="votes_abstained" optional="show" />
                <field name="company_id" groups="base.group_multi_company" />
            </list>
        </field>
    </record>
    <record id="governance_resolution_view_form" model="ir.ui.view">
        <field name="model">governance.resolution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" invisible="not number" />
                        </h1>
                        <h2>
                            <field name="name" placeholder="Subject" />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="meeting_id" />
                            <field name="body_id" />
                            <field name="outcome" />
                        </group>
                        <group>
                            <field name="votes_for" />
                            <field name="votes_against" />
                            <field name="votes_abstained" />
                        </group>
                    </group>
                    <notebook>
                        <page name="text" string="Text">
                            <field name="text" />
                        </page>
                        <page name="appointments" string="Appointments">
                            <group>
                                <field
                                    name="appointed_body_ids"
                                    widget="many2many_tags"
                                />
                            </group>
                            <field name="appointment_ids" readonly="1">
                                <list>
                                    <field name="partner_id" />
                                    <field name="role_id" />
                                    <field name="body_id" />
                                    <field name="date_start" />
                                </list>
                            </field>
                        </page>
                        <page name="terminations" string="Terminations">
                            <field name="termination_ids" readonly="1">
                                <list>
                                    <field name="partner_id" />
                                    <field name="role_id" />
                                    <field name="body_id" />
                                    <field name="date_end" />
                                    <field name="end_reason" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="governance_resolution_view_search" model="ir.ui.view">
        <field name="model">governance.resolution</field>
        <field name="arch" type="xml">
            <search>
                <field name="number" />
                <field name="name" />
                <field name="body_id" />
                <field name="meeting_id" />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('outcome', '=', 'approved')]"
                />
                <group>
                    <filter
                        name="group_body"
                        string="Body"
                        context="{'group_by': 'body_id'}"
                    />
                    <filter
                        name="group_year"
                        string="Year"
                        context="{'group_by': 'meeting_date:year'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="governance_resolution_action" model="ir.actions.act_window">
        <field name="name">Resolutions</field>
        <field name="res_model">governance.resolution</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
