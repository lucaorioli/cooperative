<odoo>
    <record id="governance_body_view_form" model="ir.ui.view">
        <field name="model">governance.body</field>
        <field name="inherit_id" ref="company_governance.governance_body_view_form" />
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div class="oe_button_box" name="button_box">
                    <button
                        name="action_view_meetings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                    >
                        <field
                            name="meeting_count"
                            widget="statinfo"
                            string="Meetings"
                        />
                    </button>
                </div>
            </div>
            <field name="term_note" position="after">
                <field name="appointment_resolution_id" />
            </field>
        </field>
    </record>
</odoo>
