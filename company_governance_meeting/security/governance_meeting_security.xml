<odoo>
    <record id="governance_meeting_company_rule" model="ir.rule">
        <field name="name">Corporate body meetings: multi-company</field>
        <field name="model_id" ref="model_governance_meeting" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="governance_meeting_attendee_company_rule" model="ir.rule">
        <field name="name">Corporate body meeting attendees: multi-company</field>
        <field name="model_id" ref="model_governance_meeting_attendee" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="governance_resolution_company_rule" model="ir.rule">
        <field name="name">Corporate body resolutions: multi-company</field>
        <field name="model_id" ref="model_governance_resolution" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
